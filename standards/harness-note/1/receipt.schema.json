{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflowx.local/standards/harness-note/1/receipt.schema.json",
  "title": "harness-receipt/1",
  "description": "S1 candidate transcription of contract C4. Immutable once created.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "mode", "attempt", "inputs", "codeManifest", "checks", "coverage", "review", "createdAt", "actor"],
  "properties": {
    "schema": { "const": "harness-receipt/1" },
    "id": { "type": "string" },
    "taskUri": { "type": "string", "pattern": "^note://.*$" },
    "mode": { "enum": ["xdo", "xdel", "xflow"] },
    "attempt": { "type": "integer", "minimum": 0 },
    "taskContractHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "contentHash"],
        "properties": {
          "uri": { "type": "string" },
          "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "criteria": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "codeManifest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["repoId", "path"],
        "properties": {
          "repoId": { "type": "string" },
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "deleted": { "type": "boolean" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "required", "status", "repoId", "summary", "performedBy"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["command", "manual"] },
          "required": { "type": "boolean" },
          "status": { "enum": ["passed", "failed", "not-run"] },
          "repoId": { "type": "string" },
          "command": { "type": "object" },
          "exitCode": { "type": "integer" },
          "summary": { "type": "string" },
          "performedBy": { "type": "string" }
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["uri", "criterionId", "criterionHash", "checkIds"],
        "properties": {
          "uri": { "type": "string" },
          "criterionId": { "type": "string" },
          "criterionHash": { "type": "string" },
          "checkIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "review": {
      "type": "object",
      "required": ["kind", "verdict", "reviewedManifestHash", "actor"],
      "properties": {
        "kind": { "enum": ["self", "independent", "manual"] },
        "verdict": { "enum": ["approved", "needs-fix", "blocked"] },
        "reviewedManifestHash": { "type": "string" },
        "actor": { "type": "string" }
      }
    },
    "createdAt": { "type": "string" },
    "actor": { "type": "string" }
  }
}
