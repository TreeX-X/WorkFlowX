{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflowx.local/standards/harness-note/1/changeset.schema.json",
  "title": "NoteChangeSet",
  "description": "S1 candidate transcription of contract C5. create/replace/delete only; single afterMarkdown source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "source", "operations"],
  "properties": {
    "id": { "type": "string" },
    "revision": { "type": "integer", "minimum": 1 },
    "source": {
      "type": "object",
      "required": ["type", "id", "revision"],
      "properties": {
        "type": { "enum": ["roundtable", "chat", "harness", "manual"] },
        "id": { "type": "string" },
        "revision": { "type": "integer", "minimum": 1 }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "type", "uri", "expectedHash", "dependsOn", "reason", "evidenceRefs"],
        "properties": {
          "operationId": { "type": "string" },
          "type": { "enum": ["create", "replace", "delete"] },
          "uri": { "type": "string", "pattern": "^note://.*$" },
          "expectedHash": { "type": ["string", "null"], "description": "create=null, replace/delete=exact SHA-256 hex" },
          "relativePath": { "type": "string" },
          "afterMarkdown": { "type": "string" },
          "dependsOn": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
