{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflowx.local/standards/harness-note/1/note.schema.json",
  "title": "harness-note/1 frontmatter",
  "description": "S1 candidate transcription of contract C1. Unknown top-level keys are SCHEMA_INVALID but preserved verbatim on disk.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "kind", "lifecycle", "created"],
  "properties": {
    "schema": { "const": "harness-note/1" },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "Lowercase UUID. Immutable identity; rename never changes it."
    },
    "kind": { "enum": ["idea", "initiative", "requirement", "decision", "task"] },
    "lifecycle": {
      "enum": ["draft", "proposed", "accepted", "rejected", "archived", "implemented"],
      "description": "implemented only for decision. See C2 transition table."
    },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "class": { "enum": ["feature", "bug-fix", "architecture", "process", "testing", "simplification"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "parent": { "type": "string", "pattern": "^note://[0-9a-f-]{36}/[0-9a-f-]{36}$" },
    "relations": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {
            "enum": ["depends-on", "implements", "governed-by", "derived-from", "supersedes", "related-to", "parent"]
          },
          "target": { "type": "string", "pattern": "^note://[0-9a-f-]{36}/[0-9a-f-]{36}$" },
          "criteria": {
            "type": "array",
            "items": { "type": "string", "pattern": "^AC-\\d+$" },
            "description": "Only for implements."
          },
          "scope": { "enum": ["full", "partial"], "description": "Only for supersedes; reason required." },
          "reason": { "type": "string" }
        }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
        "related": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f-]{36}$" } }
      }
    },
    "codeRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repoId", "path", "role"],
        "properties": {
          "repoId": { "type": "string", "pattern": "^[0-9a-f-]{36}$" },
          "path": {
            "type": "string",
            "description": "Repo-relative POSIX path. No .., drive, UNC, or empty root.",
            "pattern": "^(\\./)?([^\\0\\\\:\\*\\?\"<>|]+/)*[^\\0\\\\:\\*\\?\"<>|/]+/?$"
          },
          "symbol": { "type": "string" },
          "role": { "enum": ["entry", "implementation", "test"] }
        }
      }
    },
    "work": {
      "type": "object",
      "description": "Task-only (C3). Machine contract; prose never substitutes.",
      "additionalProperties": false,
      "required": ["scope", "acceptanceRefs", "verification"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repoId", "paths"],
            "properties": {
              "repoId": { "type": "string" },
              "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
            }
          }
        },
        "acceptanceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uri", "criterionId"],
            "properties": {
              "uri": { "type": "string" },
              "criterionId": { "type": "string", "pattern": "^AC-\\d+$" }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "required", "repoId", "cwd"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["command", "manual"] },
              "required": { "type": "boolean" },
              "repoId": { "type": "string" },
              "cwd": { "type": "string" },
              "program": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Task-only (C3). Drafts must not carry active execution.",
      "additionalProperties": false,
      "required": ["mode", "state", "baseline", "attempt", "receipts", "closeout"],
      "properties": {
        "mode": { "enum": ["xdo", "xdel", "xflow"] },
        "state": { "enum": ["queued", "running", "verifying", "blocked", "paused", "done", "cancelled"] },
        "baseline": {
          "type": "object",
          "required": ["taskContractHash", "inputs"],
          "properties": {
            "taskContractHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["uri", "contentHash"],
                "properties": {
                  "uri": { "type": "string" },
                  "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                  "criteria": { "type": "array", "items": { "type": "string" } }
                }
              }
            }
          }
        },
        "attempt": { "type": "integer", "minimum": 0 },
        "receipts": { "type": "array", "items": { "type": "string" } },
        "closeout": { "enum": ["commit-required", "working-tree-authorized"] },
        "blocker": {
          "type": "object",
          "required": ["code", "summary"],
          "properties": { "code": { "type": "string" }, "summary": { "type": "string" } }
        },
        "authorizationRef": { "type": "string" }
      }
    },
    "disposition": {
      "type": "object",
      "description": "Required for rejected/archived, forbidden otherwise.",
      "required": ["reason"],
      "properties": { "reason": { "type": "string", "minLength": 1 } }
    },
    "extensions": { "type": "object" }
  }
}
